# Copy to `.env` and fill in. The CLI loads this automatically (python-dotenv).

# Required to run the agent (drafting). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Point the agent at an OpenAI-compatible endpoint instead of Anthropic (optional).
# SPEECHWRITER_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_API_KEY=

# Optional. Enables the live web-research subagent. Without it, the agent writes
# from its own knowledge and flags unverified claims with [VERIFY]. https://tavily.com/
TAVILY_API_KEY=

# --- Optional overrides -----------------------------------------------------
# The model the session STARTS on (default: claude-sonnet-5) — both front ends can
# switch at runtime, from the sidebar dropdown or /model in the terminal. Any Claude
# id works, as does a locally served one paired with SPEECHWRITER_BASE_URL above.
# claude-opus-5 needs no ceiling override alongside it: LangChain profiles it at its
# real 128k, so tier 2 keeps it.
# SPEECHWRITER_MODEL=claude-sonnet-5

# Output-token ceiling. Leave unset unless you mean it — this is tier 1, so it wins
# for EVERY model and follows you across a runtime switch. Setting 128000 here and
# then switching to claude-haiku-4-5 asks for double its real 64k ceiling, which the
# API rejects at the first turn. Unset, each model keeps its own profiled ceiling.
# SPEECHWRITER_MAX_TOKENS=128000

# Tavily results per query (default: 5).
# SPEECHWRITER_MAX_RESEARCH_RESULTS=5
# Root dir the agent reads/writes under (default: the repo root).
# SPEECHWRITER_HOME=

# --- Optional: LangSmith tracing (observability; recommended) ---------------
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=speechwriter-agent

# Point the agent at an OpenAI-compatible endpoint instead of Anthropic (optional).
# Set SPEECHWRITER_MODEL below to the id that server actually serves; the URL selects
# the client, the id selects the model, and both are needed. No Anthropic key required.
# SPEECHWRITER_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_API_KEY=