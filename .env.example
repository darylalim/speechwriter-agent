# Claude
ANTHROPIC_API_KEY=
# SPEECHWRITER_MODEL=claude-sonnet-5-5   # optional; or claude-opus-5-5

# Optional — enables the live-research subagent.
TAVILY_API_KEY=

# Optional — output-token ceiling. Unset uses 12288, sized to clear the longest
# graded draft while leaving most of the 32768-token window for the prompt.
# Above half that window, both front ends warn that the prompt is being starved.
SPEECHWRITER_MAX_TOKENS=

# Optional — Tavily results per query (default 5).
SPEECHWRITER_MAX_RESEARCH_RESULTS=

# Optional — root dir the agent reads and writes under (default: the repo root).
# Leave this COMMENTED OUT, not blank: an empty value is still "set", and it
# resolves to whatever directory you launched from rather than the repo.
# SPEECHWRITER_HOME=

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=speechwriter-agent

# Deepgram Text to Speech
DEEPGRAM_API_KEY=